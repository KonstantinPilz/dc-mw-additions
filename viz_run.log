+      font-size: 0.8rem;
+      font-weight: 600;
+    }
+
+    .reset:hover { color: var(--ink); }
+    .reset[hidden] { display: none; }
+
+    .chart-meta {
+      display: flex;
+      justify-content: space-between;
+      gap: 24px;
+      align-items: baseline;
+      padding: 22px 24px 0;
+    }
+
+    .chart-meta strong {
+      font-size: 1rem;
+      font-weight: 650;
+    }
+
+    .chart-meta span {
+      color: var(--muted);
+      font-size: 0.82rem;
+      text-align: right;
+    }
+
+    .chart-scroll {
+      overflow-x: auto;
+      overscroll-behavior-inline: contain;
+      scrollbar-color: var(--line-strong) transparent;
+    }
+
+    #chart {
+      display: block;
+      min-height: 460px;
+      shape-rendering: geometricPrecision;
+    }
+
+    .axis text {
+      fill: var(--muted);
+      font-size: 11px;
+    }
+
+    .axis .domain { display: none; }
+
+    .axis line {
+      stroke: var(--line);
+      stroke-dasharray: 2 4;
+    }
+
+    .year-axis line { display: none; }
+
+    .year-axis text {
+      fill: var(--ink);
+      font-size: 12px;
+      font-weight: 650;
+    }
+
+    .bar {
+      cursor: pointer;
+      stroke: color-mix(in srgb, var(--surface), transparent 45%);
+      stroke-width: 0.5;
+    }
+
+    .bar:hover,
+    .bar:focus-visible {
+      filter: brightness(1.08);
+      stroke: var(--ink);
+      stroke-width: 1.2;
+    }
+
+    .axis-label {
+      fill: var(--muted);
+      font-size: 11px;
+      font-weight: 600;
+    }
+
+    .estimate-marker {
+      stroke: var(--line-strong);
+      stroke-dasharray: 3 4;
+    }
+
+    .legend-wrap {
+      padding: 18px 24px 22px;
+      border-top: 1px solid var(--line);
+    }
+
+    .legend-head {
+      display: flex;
+      justify-content: space-between;
+      gap: 18px;
+      align-items: baseline;
+      margin-bottom: 12px;
+    }
+
+    .legend-head h2 {
+      margin: 0;
+      font-size: 0.82rem;
+      font-weight: 700;
+    }
+
+    .legend-head p {
+      margin: 0;
+      color: var(--muted);
+      font-size: 0.76rem;
+    }
+
+    #legend {
+      display: grid;
+      grid-template-columns: repeat(4, minmax(0, 1fr));
+      gap: 5px 10px;
+    }
+
+    .legend-item {
+      display: flex;
+      min-width: 0;
+      gap: 8px;
+      align-items: center;
+      padding: 5px 7px;
+      color: var(--ink);
+      background: transparent;
+      border: 1px solid transparent;
+      border-radius: 6px;
+      cursor: pointer;

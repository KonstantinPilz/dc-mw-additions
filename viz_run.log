+  <script>
+    (() => {
+      "use strict";
+
+      const years = ["2022", "2023", "2024", "2025", "2026"];
+      const state = {
+        mode: "annual",
+        scale: "log",
+        count: "8",
+        selected: new Set()
+      };
+
+      const colors = [

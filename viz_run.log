import asyncio, json, urllib.request
import websockets

async def main():
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    pages = json.load(opener.open('http://[::1]:9222/json/list'))
    page = next(p for p in pages if p.get('url') == 'http://127.0.0.1:8765/')
    async with websockets.connect(page['webSocketDebuggerUrl'], origin=None) as ws:
        counter = 0
        async def evaluate(expression):
            nonlocal counter
            counter += 1
            await ws.send(json.dumps({'id': counter, 'method': 'Runtime.evaluate', 'params': {'expression': expression, 'returnByValue': True, 'awaitPromise': True}}))
            while True:
                message = json.loads(await ws.recv())
                if message.get('id') == counter:
                    result = message['result']['result']
                    if result.get('subtype') == 'error':
                        raise RuntimeError(result.get('description'))
                    return result.get('value')

        results = {}
        results['initial_bars'] = await evaluate(\"document.querySelectorAll('.bar').length\")
        results['all_bars'] = await evaluate(\"(()=>{const s=document.querySelector('#country-count');s.value='all';s.dispatchEvent(new Event('change',{bubbles:true}));return document.querySelectorAll('.bar').length})()\")
        results['mode_status'] = await evaluate(\"(()=>{const r=document.querySelector('input[value=\\\"cumulative\\\"]');r.checked=true;r.dispatchEvent(new Event('change',{bubbles:true}));const l=document.querySelector('input[value=\\\"linear\\\"]');l.checked=true;l.dispatchEvent(new Event('change',{bubbles:true}));return document.querySelector('#chart-status').textContent+' | '+document.querySelector('#chart-summary').textContent})()\")
        results['taiwan_bars'] = await evaluate(\"(()=>{document.querySelector('.legend-item[data-country=\\\"Taiwan\\\"]').click();return document.querySelectorAll('.bar').length})()\")
        results['comparison_bars'] = await evaluate(\"(()=>{document.querySelector('.legend-item[data-country=\\\"China\\\"]').click();return document.querySelectorAll('.bar').length})()\")
        results['tooltip'] = await evaluate(\"(()=>{const b=document.querySelector('.bar');b.dispatchEvent(new MouseEvent('mouseenter',{bubbles:true,clientX:200,clientY:200}));const t=document.querySelector('#tooltip');return {hidden:t.hidden,links:t.querySelectorAll('a').length,country:document.querySelector('#tooltip-country').textContent,value:document.querySelector('#tooltip-value').textContent,href:t.querySelector('a')?.href}})()\")
        results['reset_bars'] = await evaluate(\"(()=>{document.querySelector('#reset').click();return document.querySelectorAll('.bar').length})()\")
        print(json.dumps(results, indent=2, ensure_ascii=False))

asyncio.run(main())

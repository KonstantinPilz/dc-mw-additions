+        --surface: #171f23;
+        --ink: #edf1f1;
+        --muted: #a8b1b5;
+        --quiet: #7f8a90;
+        --line: #344047;
+        --line-strong: #536169;
+        --control: #222c31;
+        --focus: #56b4e9;
+        --shadow: 0 14px 36px rgb(0 0 0 / 24%);

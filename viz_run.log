+
+    h1 {
+      max-width: 780px;
+      margin: 0;
+      font-size: clamp(2rem, 4.5vw, 3.65rem);
+      font-weight: 650;
+      letter-spacing: -0.045em;
+      line-height: 1.02;
+    }
+
+    .nowrap { white-space: nowrap; }
+
+    .dek {
+      max-width: 34rem;
+      margin: 19px 0 0;
+      color: var(--muted);
+      font-size: 1.02rem;
+    }
+
+    .key {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 16px;
+      margin: 0;
+    }
+
+    .key div {
+      padding-top: 11px;
+      border-top: 1px solid var(--line-strong);
+    }
+
+    .key dt {
+      color: var(--muted);
+      font-size: 0.72rem;
+      font-weight: 700;
+      letter-spacing: 0.09em;
+      text-transform: uppercase;
+    }
+
+    .key dd {
+      margin: 4px 0 0;
+      font-size: 0.91rem;
+      font-weight: 600;
+    }
+
+    .chart-card {
+      overflow: hidden;
+      background: var(--surface);
+      border: 1px solid var(--line);
+      border-radius: 14px;
+      box-shadow: var(--shadow);
+    }
+
+    .controls {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 18px 28px;
+      align-items: end;
+      padding: 18px 22px;
+      border-bottom: 1px solid var(--line);
+    }
+
+    fieldset {
+      min-width: 0;
+      margin: 0;
+      padding: 0;
+      border: 0;
+    }
+
+    legend,
+    .select-label {
+      display: block;
+      margin-bottom: 6px;
+      color: var(--muted);
+      font-size: 0.69rem;
+      font-weight: 700;
+      letter-spacing: 0.075em;
+      text-transform: uppercase;
+    }
+
+    .segmented {
+      display: inline-flex;
+      gap: 2px;
+      padding: 3px;
+      background: var(--control);
+      border: 1px solid var(--line);
+      border-radius: 8px;
+    }
+
+    .segmented label {
+      position: relative;
+      cursor: pointer;
+    }
+
+    .segmented input {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      opacity: 0;
+    }
+
+    .segmented span {
+      display: block;
+      padding: 6px 10px;
+      border-radius: 5px;
+      color: var(--muted);
+      font-size: 0.82rem;
+      font-weight: 600;
+      white-space: nowrap;
+    }
+
+    .segmented input:checked + span {
+      color: var(--ink);
+      background: var(--surface);
+      box-shadow: 0 1px 3px rgb(20 28 32 / 12%);
+    }
+
+    select {
+      min-height: 37px;
+      padding: 6px 30px 6px 10px;
+      color: var(--ink);
+      background: var(--control);
+      border: 1px solid var(--line);
+      border-radius: 8px;
+      font-size: 0.82rem;
+      font-weight: 600;
+    }
+
+    .reset {
+      margin-left: auto;
+      padding: 7px 0;
+      color: var(--muted);
+      background: transparent;
+      border: 0;
+      border-bottom: 1px solid var(--line-strong);
+      cursor: pointer;
+      font-size: 0.8rem;
+      font-weight: 600;
+    }
+
+    .reset:hover { color: var(--ink); }
+    .reset[hidden] { display: none; }
+
+    .chart-meta {
+      display: flex;
+      justify-content: space-between;
+      gap: 24px;
+      align-items: baseline;
+      padding: 22px 24px 0;
+    }
+
+    .chart-meta strong {
+      font-size: 1rem;
+      font-weight: 650;
+    }
+
+    .chart-meta span {
+      color: var(--muted);
+      font-size: 0.82rem;
+      text-align: right;
+    }
+
+    .chart-scroll {
+      overflow-x: auto;
+      overscroll-behavior-inline: contain;
+      scrollbar-color: var(--line-strong) transparent;
+    }
+
+    #chart {
+      display: block;
+      min-height: 460px;
+      shape-rendering: geometricPrecision;
+    }
+
+    .axis text {
+      fill: var(--muted);
+      font-size: 11px;
+    }
+
+    .axis .domain { display: none; }
+
+    .axis line {
+      stroke: var(--line);
+      stroke-dasharray: 2 4;
+    }
+
+    .year-axis line { display: none; }
+
+    .year-axis text {
+      fill: var(--ink);
+      font-size: 12px;
+      font-weight: 650;
+    }
+
+    .bar {
+      cursor: pointer;
+      stroke: color-mix(in srgb, var(--surface), transparent 45%);
+      stroke-width: 0.5;
+    }
+
+    .bar:hover,
+    .bar:focus-visible {
+      filter: brightness(1.08);
+      stroke: var(--ink);
+      stroke-width: 1.2;
+    }
+
+    .axis-label {
+      fill: var(--muted);
+      font-size: 11px;
+      font-weight: 600;
+    }
+
+    .estimate-marker {
+      stroke: var(--line-strong);
+      stroke-dasharray: 3 4;
+    }
+
+    .legend-wrap {
+      padding: 18px 24px 22px;
+      border-top: 1px solid var(--line);
+    }
+
+    .legend-head {
+      display: flex;
+      justify-content: space-between;
+      gap: 18px;
+      align-items: baseline;
+      margin-bottom: 12px;
+    }
+
+    .legend-head h2 {
+      margin: 0;
+      font-size: 0.82rem;
+      font-weight: 700;
+    }
+
+    .legend-head p {
+      margin: 0;
+      color: var(--muted);
+      font-size: 0.76rem;
+    }
+
+    #legend {
+      display: grid;
+      grid-template-columns: repeat(4, minmax(0, 1fr));
+      gap: 5px 10px;
+    }
+
+    .legend-item {
+      display: flex;
+      min-width: 0;
+      gap: 8px;
+      align-items: center;
+      padding: 5px 7px;
+      color: var(--ink);
+      background: transparent;
+      border: 1px solid transparent;
+      border-radius: 6px;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    .legend-item:hover { background: var(--control); }
+
+    .legend-item.not-shown {
+      color: var(--quiet);
+      opacity: 0.7;
+    }
+
+    .legend-item.selected {
+      background: var(--control);
+      border-color: var(--line-strong);
+      opacity: 1;
+    }
+
+    .swatch {
+      flex: 0 0 auto;
+      width: 10px;
+      height: 10px;
+      border-radius: 2px;
+    }
+
+    .country-name {
+      overflow: hidden;
+      font-size: 0.76rem;
+      font-weight: 550;
+      text-overflow: ellipsis;
+      white-space: nowrap;
+    }
+
+    .tooltip {
+      position: fixed;
+      z-index: 10;
+      width: min(420px, calc(100vw - 24px));
+      max-height: min(520px, calc(100vh - 24px));
+      overflow-y: auto;
+      padding: 15px 16px 16px;
+      color: var(--ink);
+      background: color-mix(in srgb, var(--surface), transparent 2%);
+      border: 1px solid var(--line-strong);
+      border-radius: 10px;
+      box-shadow: 0 14px 36px rgb(0 0 0 / 20%);
+      pointer-events: auto;
+    }
+
+    .tooltip[hidden] { display: none; }
+
+    .tooltip-top {
+      display: flex;
+      justify-content: space-between;
+      gap: 16px;
+      align-items: start;
+      margin-bottom: 10px;
+      padding-bottom: 10px;
+      border-bottom: 1px solid var(--line);
+    }
+
+    .tooltip h3 {
+      margin: 0;
+      font-size: 0.92rem;
+      line-height: 1.3;
+    }
+
+    .tooltip-year {
+      margin: 2px 0 0;

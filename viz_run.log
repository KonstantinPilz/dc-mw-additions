+      gap: 2px;
+      padding: 3px;
+      background: var(--control);
+      border: 1px solid var(--line);
+      border-radius: 8px;
+    }
+
+    .segmented label {
+      position: relative;
+      cursor: pointer;
+    }
+
+    .segmented input {
+      position: absolute;
+      width: 1px;

<body>
  <main class="page">
    <header class="masthead">
      <div>
        <p class="eyebrow">IT power · median estimates</p>
        <h1>Data-center capacity additions by country, <span class="nowrap">2022–2026</span></h1>
        <p class="dek">Compare annual additions or each country’s cumulative build-out. The default log scale keeps smaller markets legible beside the United States and China.</p>
      </div>
      <dl class="key" aria-label="Chart definitions">
        <div>
          <dt>Measure</dt>
          <dd>Critical IT capacity</dd>
        </div>
        <div>
          <dt>2026</dt>
          <dd>Full-year estimate</dd>
        </div>
      </dl>
    </header>

    <section class="chart-card" aria-label="Interactive capacity additions chart">
      <form class="controls" id="controls">
        <fieldset>
          <legend>Measure</legend>
          <div class="segmented">
            <label><input type="radio" name="mode" value="annual" checked><span>Annual</span></label>
            <label><input type="radio" name="mode" value="cumulative"><span>Since 2022</span></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Scale</legend>
          <div class="segmented">
            <label><input type="radio" name="scale" value="log" checked><span>Log</span></label>
            <label><input type="radio" name="scale" value="linear"><span>Linear</span></label>
          </div>
        </fieldset>

        <label>
          <span class="select-label">Countries</span>
          <select id="country-count" aria-label="Number of countries shown">
            <option value="8">Top 8</option>
            <option value="12">Top 12</option>
            <option value="all">All 22</option>
          </select>
        </label>

        <button class="reset" id="reset" type="button" hidden>Return to ranking</button>
      </form>

      <div class="chart-meta" aria-live="polite">
        <strong id="chart-status">Loading data…</strong>
        <span id="chart-summary"></span>
      </div>

      <div class="chart-scroll" id="chart-scroll">
        <svg id="chart" role="img" aria-labelledby="svg-title svg-desc">
          <title id="svg-title">Data-center capacity additions by country from 2022 to 2026</title>
          <desc id="svg-desc">A grouped bar chart. Use the controls to change the measure, scale, and countries shown.</desc>
        </svg>
      </div>

      <div class="legend-wrap">
        <div class="legend-head">
          <h2>Countries</h2>
          <p>Click one to isolate it, then add others to compare.</p>
        </div>
        <div id="legend" aria-label="Country comparison controls"></div>
      </div>
    </section>

    <footer>
      <p>Data: Konstantin's Claude research team, 2026-08-12. Medians; 2026 is a full-year estimate. Definitions: IT (critical) MW, colo + hyperscale + AI campuses.</p>
      <p class="caveat">China 2024–25 partly reflects a statistical series change; US 2026 follows SemiAnalysis's construction-backed forecast.</p>
    </footer>
  </main>

  <aside class="tooltip" id="tooltip" hidden aria-live="polite">
    <div class="tooltip-top">
      <div>
        <h3 id="tooltip-country"></h3>
        <p class="tooltip-year" id="tooltip-year"></p>
      </div>
      <div class="tooltip-value" id="tooltip-value"></div>
    </div>
    <p class="tooltip-reasoning" id="tooltip-reasoning"></p>
  </aside>

  <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
  <script>
    (() => {
      "use strict";

      const years = ["2022", "2023", "2024", "2025", "2026"];
      const state = {
        mode: "annual",
        scale: "log",
        count: "8",
        selected: new Set()
      };

      const colors = [
        "#5f7891", "#6f7f4a", "#8b6c98", "#4f8677", "#a36269",
        "#947142", "#527e99", "#8a6f60", "#607d68", "#7f6882",
        "#a06845", "#497a85", "#746f5b", "#6d7391", "#5b826f",
        "#8c6469", "#657b46", "#8b704f", "#53768f", "#77677e"
      ];
      const specialColors = {
        "United States": "#0072b2",
        "China": "#d55e00"
      };

      const svg = d3.select("#chart");
      const chartScroll = document.querySelector("#chart-scroll");
      const status = document.querySelector("#chart-status");
      const summary = document.querySelector("#chart-summary");
      const legend = document.querySelector("#legend");
      const reset = document.querySelector("#reset");
      const tooltip = document.querySelector("#tooltip");
      const numberFormat = d3.format(",.0f");
      let countries = [];
      let rankedCountries = [];
      let colorByCountry = new Map();
      let hideTimer;

      // Top-eight plus a log scale is the default because a 24,000 MW U.S. value
      // and a 44 MW Taiwan value cannot both read clearly on one linear axis.
      // The ranking selector exposes every country; legend choices override it.
      fetch("data.json")
        .then(response => {
          if (!response.ok) throw new Error(`Data request failed (${response.status})`);
          return response.json();
        })
        .then(data => {
          countries = Object.entries(data.countries).map(([country, values]) => {
            let running = 0;
            const observations = years.map(year => {
              const observation = values[year];
              running += observation.mw;
              return {
                country,
                year,
                annual: observation.mw,
                cumulative: running,
                reasoning: observation.reasoning
              };
            });
            return { country, observations, total: running };
          });

          rankedCountries = countries
            .slice()
            .sort((a, b) => d3.descending(a.total, b.total))
            .map(d => d.country);

          let paletteIndex = 0;
          rankedCountries.forEach(country => {
            colorByCountry.set(country, specialColors[country] || colors[paletteIndex++ % colors.length]);
          });

          buildLegend();
          render();
        })
        .catch(error => {
          status.textContent = "Unable to load the dataset";
          summary.textContent = "";
          chartScroll.innerHTML = `<p class="error">${escapeText(error.message)}. Serve this directory over HTTP so the page can fetch data.json.</p>`;
        });

      document.querySelector("#controls").addEventListener("change", event => {
        if (event.target.name === "mode") state.mode = event.target.value;
        if (event.target.name === "scale") state.scale = event.target.value;
        if (event.target.id === "country-count") {
          state.count = event.target.value;
          state.selected.clear();
        }
        render();
      });

      reset.addEventListener("click", () => {
        state.selected.clear();
        hideTooltip();
        render();
      });

      tooltip.addEventListener("mouseenter", () => clearTimeout(hideTimer));
      tooltip.addEventListener("mouseleave", scheduleTooltipHide);
      window.addEventListener("resize", debounce(render, 120));
      window.addEventListener("scroll", hideTooltip, { passive: true });

      function visibleCountryNames() {
        if (state.selected.size) {
          return rankedCountries.filter(country => state.selected.has(country));
        }
        const count = state.count === "all" ? rankedCountries.length : Number(state.count);
        return rankedCountries.slice(0, count);
      }

      function buildLegend() {
        legend.replaceChildren();
        rankedCountries.forEach(country => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "legend-item";
          button.dataset.country = country;
          button.setAttribute("aria-pressed", "false");
          button.title = `Compare ${country}`;

          const swatch = document.createElement("span");
          swatch.className = "swatch";
          swatch.style.backgroundColor = colorByCountry.get(country);
          swatch.setAttribute("aria-hidden", "true");

          const name = document.createElement("span");
          name.className = "country-name";
          name.textContent = country;

          button.append(swatch, name);
          button.addEventListener("click", () => {
            if (!state.selected.size) {
              state.selected.add(country);
            } else if (state.selected.has(country)) {
              state.selected.delete(country);
            } else {
              state.selected.add(country);
            }
            hideTooltip();
            render();
          });
          legend.append(button);
        });
      }

      function render() {
        if (!countries.length) return;

        hideTooltip();
        const visibleNames = visibleCountryNames();
        const visible = countries.filter(d => visibleNames.includes(d.country));
        const values = visible.flatMap(country => country.observations.map(observation => ({
          ...observation,
          value: observation[state.mode]
        })));

        // All-country mode needs slightly more horizontal room so each grouped bar
        // remains a usable hover target on small screens.
        const availableWidth = Math.max(chartScroll.clientWidth, 320);
        const minWidth = Math.max(680, visibleNames.length * 31 + 330);
        const width = Math.max(availableWidth, minWidth);
        const height = 480;
        const margin = { top: 38, right: 24, bottom: 52, left: width < 760 ? 58 : 70 };
        const innerWidth = width - margin.left - margin.right;
        const innerHeight = height - margin.top - margin.bottom;
        const maxValue = d3.max(values, d => d.value);

        svg.attr("width", width).attr("height", height).attr("viewBox", `0 0 ${width} ${height}`);
        svg.selectAll("g.chart-layer").remove();

        const root = svg.append("g")
          .attr("class", "chart-layer")
          .attr("transform", `translate(${margin.left},${margin.top})`);

        const xYear = d3.scaleBand()
          .domain(years)
          .range([0, innerWidth])
          .paddingInner(0.22)
          .paddingOuter(0.05);

        const xCountry = d3.scaleBand()
          .domain(visibleNames)
          .range([0, xYear.bandwidth()])
          .padding(0.08);

        const logFloor = 5;
        const y = state.scale === "log"
          ? d3.scaleLog().domain([logFloor, Math.max(10, maxValue * 1.14)]).range([innerHeight, 0]).nice()
          : d3.scaleLinear().domain([0, maxValue * 1.08]).range([innerHeight, 0]).nice();

        const tickValues = state.scale === "log"
          ? [10, 100, 1000, 10000].filter(value => value <= y.domain()[1])
          : y.ticks(6);

        root.append("g")
          .attr("class", "axis y-axis")
          .call(
            d3.axisLeft(y)
              .tickValues(tickValues)
              .tickSize(-innerWidth)
              .tickPadding(9)
              .tickFormat(numberFormat)
          );

        root.append("text")
          .attr("class", "axis-label")
          .attr("x", 0)
          .attr("y", -19)
          .text(state.mode === "annual" ? "MW added" : "Cumulative MW since 2022");

        const estimateX = xYear("2026") - xYear.step() * 0.11;
        root.append("line")
          .attr("class", "estimate-marker")
          .attr("x1", estimateX)
          .attr("x2", estimateX)
          .attr("y1", 0)
          .attr("y2", innerHeight);

        const yearGroups = root.selectAll("g.year-group")
          .data(years)
          .join("g")
          .attr("class", "year-group")
          .attr("transform", year => `translate(${xYear(year)},0)`);

        yearGroups.selectAll("rect")
          .data(year => values.filter(d => d.year === year))
          .join("rect")
          .attr("class", "bar")
          .attr("x", d => xCountry(d.country))
          .attr("y", d => y(d.value))
          .attr("width", Math.max(1, xCountry.bandwidth()))
          .attr("height", d => Math.max(1, y(state.scale === "log" ? logFloor : 0) - y(d.value)))
          .attr("rx", 1.5)
          .attr("fill", d => colorByCountry.get(d.country))
          .attr("tabindex", 0)
          .attr("role", "img")
          .attr("aria-label", d => `${d.country}, ${d.year}: ${numberFormat(d.value)} megawatts${state.mode === "cumulative" ? " cumulative since 2022" : " added"}`)
          .on("mouseenter", (event, d) => showTooltip(event, d))
          .on("mousemove", (event) => positionTooltip(event.clientX, event.clientY))
          .on("mouseleave", scheduleTooltipHide)
          .on("focus", (event, d) => showTooltipForElement(event.currentTarget, d))
          .on("blur", scheduleTooltipHide);

        root.append("g")
          .attr("class", "axis year-axis")
          .attr("transform", `translate(0,${innerHeight})`)
          .call(d3.axisBottom(xYear).tickSize(0).tickPadding(15).tickFormat(year => year === "2026" ? "2026 est." : year));

        const lastYearValue = d => d.observations[d.observations.length - 1][state.mode];
        const visibleTotal = d3.sum(visible, lastYearValue);
        const largest = d3.greatest(visible, lastYearValue);
        const scaleLabel = state.scale === "log" ? "Log scale · bars start at 5 MW" : "Linear scale · starts at zero";
        const selectionLabel = state.selected.size
          ? `${visibleNames.length} selected ${visibleNames.length === 1 ? "country" : "countries"}`
          : `${visibleNames.length} countries ranked by 2022–26 total`;

        status.textContent = `${state.mode === "annual" ? "Annual additions" : "Cumulative additions"} · ${selectionLabel}`;
        const scrollLabel = window.innerWidth <= 540 ? "Swipe chart → · " : "";
        summary.textContent = `${scrollLabel}${scaleLabel} · 2026 shown: ${numberFormat(visibleTotal)} MW · Largest: ${largest.country}`;
        reset.hidden = state.selected.size === 0;

        document.querySelectorAll(".legend-item").forEach(button => {
          const country = button.dataset.country;
          const selected = state.selected.has(country);
          button.classList.toggle("selected", selected);
          button.classList.toggle("not-shown", !visibleNames.includes(country));
          button.setAttribute("aria-pressed", String(selected));
        });
      }

      function showTooltip(event, datum) {
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(event.clientX, event.clientY);
      }

      function showTooltipForElement(element, datum) {
        const bounds = element.getBoundingClientRect();
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
      }

      function fillTooltip(datum) {
        document.querySelector("#tooltip-country").textContent = datum.country;
        document.querySelector("#tooltip-year").textContent = datum.year === "2026" ? "2026 · full-year estimate" : datum.year;
        document.querySelector("#tooltip-value").textContent = `${numberFormat(datum.value)} MW`;
        const reasoning = document.querySelector("#tooltip-reasoning");
        reasoning.replaceChildren();
        appendMarkdownLinks(reasoning, datum.reasoning);

        if (state.mode === "cumulative") {
          const note = document.createTextNode(` Cumulative since 2022; the source note above describes the ${datum.year} annual addition of ${numberFormat(datum.annual)} MW.`);
          reasoning.append(note);
        }
      }

      function appendMarkdownLinks(container, text) {
        const pattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g;
        let cursor = 0;
        let match;
        while ((match = pattern.exec(text)) !== null) {
          container.append(document.createTextNode(text.slice(cursor, match.index)));
          const link = document.createElement("a");
          link.href = match[2];
          link.textContent = match[1];
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          container.append(link);
          cursor = pattern.lastIndex;
        }
        container.append(document.createTextNode(text.slice(cursor)));
      }

      function positionTooltip(clientX, clientY) {
        if (tooltip.hidden) return;
        const gap = 14;
        const bounds = tooltip.getBoundingClientRect();
        let left = clientX + gap;
        let top = clientY + gap;
        if (left + bounds.width > window.innerWidth - 8) left = clientX - bounds.width - gap;
        if (top + bounds.height > window.innerHeight - 8) top = clientY - bounds.height - gap;
        tooltip.style.left = `${Math.max(8, left)}px`;
        tooltip.style.top = `${Math.max(8, top)}px`;
      }

      function scheduleTooltipHide() {
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hideTooltip, 180);
      }

      function hideTooltip() {
        clearTimeout(hideTimer);
        tooltip.hidden = true;
      }

      function debounce(fn, wait) {
        let timer;
        return (...args) => {
          clearTimeout(timer);
          timer = setTimeout(() => fn(...args), wait);
        };
      }

      function escapeText(text) {
        const node = document.createElement("div");
        node.textContent = text;
        return node.innerHTML;
      }
    })();
  </script>
</body>
</html>

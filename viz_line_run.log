" cx="643" cy="187.4288905161033" r="4.2" stroke="#8b6c98"></circle><circle class="point-hit" cx="0" cy="237.4956144994282" r="10" tabindex="0" role="img" aria-label="Japan, 2022: 115 megawatts added"></circle><circle class="point-hit" cx="160.75" cy="220.8125243450365" r="10" tabindex="0" role="img" aria-label="Japan, 2023: 185 megawatts added"></circle><circle class="point-hit" cx="321.5" cy="217.21028802669505" r="10" tabindex="0" role="img" aria-label="Japan, 2024: 205 megawatts added"></circle><circle class="point-hit" cx="482.25" cy="202.69797513819074" r="10" tabindex="0" role="img" aria-label="Japan, 2025: 310 megawatts added"></circle><circle class="point-hit" cx="643" cy="187.4288905161033" r="10" tabindex="0" role="img" aria-label="Japan, 2026: 479 megawatts added"></circle></g><g class="country-series"><path class="country-line observed-segment" d="M0,231.869L160.75,228.172L321.5,227.021L482.25,202.025" stroke="#4f8677"></path><path class="country-line estimate-segment" d="M482.25,202.025L643,209.967" stroke="#4f8677"></path><circle class="data-point" cx="0" cy="231.8690315056035" r="3" fill="#4f8677" stroke="#4f8677"></circle><circle class="data-point" cx="160.75" cy="228.17182626830095" r="3" fill="#4f8677" stroke="#4f8677"></circle><circle class="data-point" cx="321.5" cy="227.02119878784046" r="3" fill="#4f8677" stroke="#4f8677"></circle><circle class="data-point" cx="482.25" cy="202.025283724433" r="3" fill="#4f8677" stroke="#4f8677"></circle><circle class="data-point estimate-point" cx="643" cy="209.96683630485123" r="4.2" stroke="#4f8677"></circle><circle class="point-hit" cx="0" cy="231.8690315056035" r="10" tabindex="0" role="img" aria-label="Nordics, 2022: 135 megawatts added"></circle><circle class="point-hit" cx="160.75" cy="228.17182626830095" r="10" tabindex="0" role="img" aria-label="Nordics, 2023: 150 megawatts added"></circle><circle class="point-hit" cx="321.5" cy="227.02119878784046" r="10" tabindex="0" role="img" aria-label="Nordics, 2024: 155 megawatts added"></circle><circle class="point-hit" cx="482.25" cy="202.025283724433" r="10" tabindex="0" role="img" aria-label="Nordics, 2025: 316 megawatts added"></circle><circle class="point-hit" cx="643" cy="209.96683630485123" r="10" tabindex="0" role="img" aria-label="Nordics, 2026: 252 megawatts added"></circle></g><g class="country-series"><path class="country-line observed-segment" d="M0,228.172L160.75,246.097L321.5,219.693L482.25,201.148" stroke="#a36269"></path><path class="country-line estimate-segment" d="M482.25,201.148L643,237.802" stroke="#a36269"></path><circle class="data-point" cx="0" cy="228.17182626830095" r="3" fill="#a36269" stroke="#a36269"></circle><circle class="data-point" cx="160.75" cy="246.09720523730257" r="3" fill="#a36269" stroke="#a36269"></circle><circle class="data-point" cx="321.5" cy="219.69250392638358" r="3" fill="#a36269" stroke="#a36269"></circle><circle class="data-point" cx="482.25" cy="201.14796317530576" r="3" fill="#a36269" stroke="#a36269"></circle><circle class="data-point estimate-point" cx="643" cy="237.80208801201297" r="4.2" stroke="#a36269"></circle><circle class="point-hit" cx="0" cy="228.17182626830095" r="10" tabindex="0" role="img" aria-label="United Kingdom, 2022: 150 megawatts added"></circle><circle class="point-hit" cx="160.75" cy="246.09720523730257" r="10" tabindex="0" role="img" aria-label="United Kingdom, 2023: 90 megawatts added"></circle><circle class="point-hit" cx="321.5" cy="219.69250392638358" r="10" tabindex="0" role="img" aria-label="United Kingdom, 2024: 191 megawatts added"></circle><circle class="point-hit" cx="482.25" cy="201.14796317530576" r="10" tabindex="0" role="img" aria-label="United Kingdom, 2025: 324 megawatts added"></circle><circle class="point-hit" cx="643" cy="237.80208801201297" r="10" tabindex="0" role="img" aria-label="United Kingdom, 2026: 114 megawatts added"></circle></g><g class="country-series"><path class="country-line observed-segment" d="M0,210.246L160.75,254.916L321.5,242.4L482.25,242.4" stroke="#947142"></path><path class="country-line estimate-segment" d="M482.25,242.4L643,203.849" stroke="#947142"></path><circle class="data-point" cx="0" cy="210.2464472992994" r="3" fill="#947142" stroke="#947142"></circle><circle class="data-point" cx="160.75" cy="254.91607836684804" r="3" fill="#947142" stroke="#947142"></circle><circle class="data-point" cx="321.5" cy="242.39999999999998" r="3" fill="#947142" stroke="#947142"></circle><circle class="data-point" cx="482.25" cy="242.39999999999998" r="3" fill="#947142" stroke="#947142"></circle><circle class="data-point estimate-point" cx="643" cy="203.8486026186513" r="4.2" stroke="#947142"></circle><circle class="point-hit" cx="0" cy="210.2464472992994" r="10" tabindex="0" role="img" aria-label="Australia, 2022: 250 megawatts added"></circle><circle class="point-hit" cx="160.75" cy="254.91607836684804" r="10" tabindex="0" role="img" aria-label="Australia, 2023: 70 megawatts added"></circle><circle class="point-hit" cx="321.5" cy="242.39999999999998" r="10" tabindex="0" role="img" aria-label="Australia, 2024: 100 megawatts added"></circle><circle class="point-hit" cx="482.25" cy="242.39999999999998" r="10" tabindex="0" role="img" aria-label="Australia, 2025: 100 megawatts added"></circle><circle class="point-hit" cx="643" cy="203.8486026186513" r="10" tabindex="0" role="img" aria-label="Australia, 2026: 300 megawatts added"></circle></g></g><g class="axis year-axis" transform="translate(0,404)" fill="none" font-size="10" font-family="sans-serif" text-anchor="middle"><path class="domain" stroke="currentColor" d="M0.5,0.5H643.5"></path><g class="tick" opacity="1" transform="translate(0.5,0)"><line stroke="currentColor" y2="0"></line><text fill="currentColor" y="15" dy="0.71em">2022</text></g><g class="tick" opacity="1" transform="translate(161.25,0)"><line stroke="currentColor" y2="0"></line><text fill="currentColor" y="15" dy="0.71em">2023</text></g><g class="tick" opacity="1" transform="translate(322,0)"><line stroke="currentColor" y2="0"></line><text fill="currentColor" y="15" dy="0.71em">2024</text></g><g class="tick" opacity="1" transform="translate(482.75,0)"><line stroke="currentColor" y2="0"></line><text fill="currentColor" y="15" dy="0.71em">2025</text></g><g class="tick" opacity="1" transform="translate(643.5,0)"><line stroke="currentColor" y2="0"></line><text fill="currentColor" y="15" dy="0.71em">2026 est.</text></g></g></g></svg>
      </div>

      <div class="legend-wrap">
        <div class="legend-head">
          <h2>Countries</h2>
          <p>Click one to isolate it, then add others to compare.</p>
        </div>
        <div id="legend" aria-label="Country comparison controls"><button type="button" class="legend-item" data-country="United States" aria-pressed="false" title="Compare United States"><span class="swatch" aria-hidden="true" style="background-color: rgb(0, 114, 178);"></span><span class="country-name">United States</span></button><button type="button" class="legend-item" data-country="China" aria-pressed="false" title="Compare China"><span class="swatch" aria-hidden="true" style="background-color: rgb(213, 94, 0);"></span><span class="country-name">China</span></button><button type="button" class="legend-item" data-country="Malaysia" aria-pressed="false" title="Compare Malaysia"><span class="swatch" aria-hidden="true" style="background-color: rgb(95, 120, 145);"></span><span class="country-name">Malaysia</span></button><button type="button" class="legend-item" data-country="India" aria-pressed="false" title="Compare India"><span class="swatch" aria-hidden="true" style="background-color: rgb(111, 127, 74);"></span><span class="country-name">India</span></button><button type="button" class="legend-item" data-country="Japan" aria-pressed="false" title="Compare Japan"><span class="swatch" aria-hidden="true" style="background-color: rgb(139, 108, 152);"></span><span class="country-name">Japan</span></button><button type="button" class="legend-item" data-country="Nordics" aria-pressed="false" title="Compare Nordics"><span class="swatch" aria-hidden="true" style="background-color: rgb(79, 134, 119);"></span><span class="country-name">Nordics</span></button><button type="button" class="legend-item" data-country="United Kingdom" aria-pressed="false" title="Compare United Kingdom"><span class="swatch" aria-hidden="true" style="background-color: rgb(163, 98, 105);"></span><span class="country-name">United Kingdom</span></button><button type="button" class="legend-item" data-country="Australia" aria-pressed="false" title="Compare Australia"><span class="swatch" aria-hidden="true" style="background-color: rgb(148, 113, 66);"></span><span class="country-name">Australia</span></button><button type="button" class="legend-item not-shown" data-country="Germany" aria-pressed="false" title="Compare Germany"><span class="swatch" aria-hidden="true" style="background-color: rgb(82, 126, 153);"></span><span class="country-name">Germany</span></button><button type="button" class="legend-item not-shown" data-country="South Korea" aria-pressed="false" title="Compare South Korea"><span class="swatch" aria-hidden="true" style="background-color: rgb(138, 111, 96);"></span><span class="country-name">South Korea</span></button><button type="button" class="legend-item not-shown" data-country="Ireland" aria-pressed="false" title="Compare Ireland"><span class="swatch" aria-hidden="true" style="background-color: rgb(96, 125, 104);"></span><span class="country-name">Ireland</span></button><button type="button" class="legend-item not-shown" data-country="United Arab Emirates" aria-pressed="false" title="Compare United Arab Emirates"><span class="swatch" aria-hidden="true" style="background-color: rgb(127, 104, 130);"></span><span class="country-name">United Arab Emirates</span></button><button type="button" class="legend-item not-shown" data-country="Saudi Arabia" aria-pressed="false" title="Compare Saudi Arabia"><span class="swatch" aria-hidden="true" style="background-color: rgb(160, 104, 69);"></span><span class="country-name">Saudi Arabia</span></button><button type="button" class="legend-item not-shown" data-country="Spain" aria-pressed="false" title="Compare Spain"><span class="swatch" aria-hidden="true" style="background-color: rgb(73, 122, 133);"></span><span class="country-name">Spain</span></button><button type="button" class="legend-item not-shown" data-country="Italy" aria-pressed="false" title="Compare Italy"><span class="swatch" aria-hidden="true" style="background-color: rgb(116, 111, 91);"></span><span class="country-name">Italy</span></button><button type="button" class="legend-item not-shown" data-country="Canada" aria-pressed="false" title="Compare Canada"><span class="swatch" aria-hidden="true" style="background-color: rgb(109, 115, 145);"></span><span class="country-name">Canada</span></button><button type="button" class="legend-item not-shown" data-country="France" aria-pressed="false" title="Compare France"><span class="swatch" aria-hidden="true" style="background-color: rgb(91, 130, 111);"></span><span class="country-name">France</span></button><button type="button" class="legend-item not-shown" data-country="Netherlands" aria-pressed="false" title="Compare Netherlands"><span class="swatch" aria-hidden="true" style="background-color: rgb(140, 100, 105);"></span><span class="country-name">Netherlands</span></button><button type="button" class="legend-item not-shown" data-country="Indonesia" aria-pressed="false" title="Compare Indonesia"><span class="swatch" aria-hidden="true" style="background-color: rgb(101, 123, 70);"></span><span class="country-name">Indonesia</span></button><button type="button" class="legend-item not-shown" data-country="Singapore" aria-pressed="false" title="Compare Singapore"><span class="swatch" aria-hidden="true" style="background-color: rgb(139, 112, 79);"></span><span class="country-name">Singapore</span></button><button type="button" class="legend-item not-shown" data-country="Brazil" aria-pressed="false" title="Compare Brazil"><span class="swatch" aria-hidden="true" style="background-color: rgb(83, 118, 143);"></span><span class="country-name">Brazil</span></button><button type="button" class="legend-item not-shown" data-country="Taiwan" aria-pressed="false" title="Compare Taiwan"><span class="swatch" aria-hidden="true" style="background-color: rgb(119, 103, 126);"></span><span class="country-name">Taiwan</span></button></div>
      </div>
    </section>

    <footer>
      <p>Data: Konstantin's Claude research team, 2026-08-12. Medians; 2026 is a full-year estimate. Definitions: IT (critical) MW, colo + hyperscale + AI campuses.</p>
      <p class="caveat">China 2024–25 partly reflects a statistical series change; US 2026 follows SemiAnalysis's construction-backed forecast.</p>
    </footer>
  </main>

  <aside class="tooltip" id="tooltip" hidden="" aria-live="polite">
    <div class="tooltip-top">
      <div>
        <h3 id="tooltip-country"></h3>
        <p class="tooltip-year" id="tooltip-year"></p>
      </div>
      <div class="tooltip-value" id="tooltip-value"></div>
    </div>
    <p class="tooltip-reasoning" id="tooltip-reasoning"></p>
  </aside>

  <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
  <script>
    (() => {
      "use strict";

      const years = ["2022", "2023", "2024", "2025", "2026"];
      const state = {
        mode: "annual",
        scale: "log",
        count: "8",
        selected: new Set()
      };

      const colors = [
        "#5f7891", "#6f7f4a", "#8b6c98", "#4f8677", "#a36269",
        "#947142", "#527e99", "#8a6f60", "#607d68", "#7f6882",
        "#a06845", "#497a85", "#746f5b", "#6d7391", "#5b826f",
        "#8c6469", "#657b46", "#8b704f", "#53768f", "#77677e"
      ];
      const specialColors = {
        "United States": "#0072b2",
        "China": "#d55e00"
      };

      const svg = d3.select("#chart");
      const chartScroll = document.querySelector("#chart-scroll");
      const status = document.querySelector("#chart-status");
      const summary = document.querySelector("#chart-summary");
      const legend = document.querySelector("#legend");
      const reset = document.querySelector("#reset");
      const tooltip = document.querySelector("#tooltip");
      const numberFormat = d3.format(",.0f");
      let countries = [];
      let rankedCountries = [];
      let colorByCountry = new Map();
      let hideTimer;

      // Top-eight plus a log scale is the default because a 24,000 MW U.S. value
      // and a 44 MW Taiwan value cannot both read clearly on one linear axis.
      // The ranking selector exposes every country; legend choices override it.
      fetch("data.json")
        .then(response => {
          if (!response.ok) throw new Error(`Data request failed (${response.status})`);
          return response.json();
        })
        .then(data => {
          countries = Object.entries(data.countries).map(([country, values]) => {
            let running = 0;
            const observations = years.map(year => {
              const observation = values[year];
              running += observation.mw;
              return {
                country,
                year,
                annual: observation.mw,
                cumulative: running,
                reasoning: observation.reasoning
              };
            });
            return { country, observations, total: running };
          });

          rankedCountries = countries
            .slice()
            .sort((a, b) => d3.descending(a.total, b.total))
            .map(d => d.country);

          let paletteIndex = 0;
          rankedCountries.forEach(country => {
            colorByCountry.set(country, specialColors[country] || colors[paletteIndex++ % colors.length]);
          });

          buildLegend();
          render();
        })
        .catch(error => {
          status.textContent = "Unable to load the dataset";
          summary.textContent = "";
          chartScroll.innerHTML = `<p class="error">${escapeText(error.message)}. Serve this directory over HTTP so the page can fetch data.json.</p>`;
        });

      document.querySelector("#controls").addEventListener("change", event => {
        if (event.target.name === "mode") state.mode = event.target.value;
        if (event.target.name === "scale") state.scale = event.target.value;
        if (event.target.id === "country-count") {
          state.count = event.target.value;
          state.selected.clear();
        }
        render();
      });

      reset.addEventListener("click", () => {
        state.selected.clear();
        hideTooltip();
        render();
      });

      tooltip.addEventListener("mouseenter", () => clearTimeout(hideTimer));
      tooltip.addEventListener("mouseleave", scheduleTooltipHide);
      window.addEventListener("resize", debounce(render, 120));
      window.addEventListener("scroll", hideTooltip, { passive: true });

      function visibleCountryNames() {
        if (state.selected.size) {
          return rankedCountries.filter(country => state.selected.has(country));
        }
        const count = state.count === "all" ? rankedCountries.length : Number(state.count);
        return rankedCountries.slice(0, count);
      }

      function buildLegend() {
        legend.replaceChildren();
        rankedCountries.forEach(country => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "legend-item";
          button.dataset.country = country;
          button.setAttribute("aria-pressed", "false");
          button.title = `Compare ${country}`;

          const swatch = document.createElement("span");
          swatch.className = "swatch";
          swatch.style.backgroundColor = colorByCountry.get(country);
          swatch.setAttribute("aria-hidden", "true");

          const name = document.createElement("span");
          name.className = "country-name";
          name.textContent = country;

          button.append(swatch, name);
          button.addEventListener("click", () => {
            if (!state.selected.size) {
              state.selected.add(country);
            } else if (state.selected.has(country)) {
              state.selected.delete(country);
            } else {
              state.selected.add(country);
            }
            hideTooltip();
            render();
          });
          legend.append(button);
        });
      }

      function render() {
        if (!countries.length) return;

        hideTooltip();
        const visibleNames = visibleCountryNames();
        const countryByName = new Map(countries.map(country => [country.country, country]));
        const visible = visibleNames.map(country => countryByName.get(country));
        const series = visible.map(country => ({
          ...country,
          observations: country.observations.map(observation => ({
            ...observation,
            value: observation[state.mode]
          }))
        }));
        const values = series.flatMap(country => country.observations);

        const availableWidth = Math.max(chartScroll.clientWidth, 320);
        const width = availableWidth;
        const height = width < 560 ? 450 : 500;
        const showDirectLabels = width >= 760;
        const margin = {
          top: 38,
          right: showDirectLabels ? 132 : 22,
          bottom: 58,
          left: width < 560 ? 54 : 70
        };
        const innerWidth = width - margin.left - margin.right;
        const innerHeight = height - margin.top - margin.bottom;
        const maxValue = d3.max(values, d => d.value);

        svg.attr("width", width).attr("height", height).attr("viewBox", `0 0 ${width} ${height}`);
        svg.selectAll("g.chart-layer").remove();

        const root = svg.append("g")
          .attr("class", "chart-layer")
          .attr("transform", `translate(${margin.left},${margin.top})`);

        const xYear = d3.scalePoint()
          .domain(years)
          .range([0, innerWidth]);

        const logFloor = 5;
        const y = state.scale === "log"
          ? d3.scaleLog().domain([logFloor, Math.max(10, maxValue * 1.14)]).range([innerHeight, 0]).nice()
          : d3.scaleLinear().domain([0, maxValue * 1.08]).range([innerHeight, 0]).nice();

        const tickValues = state.scale === "log"
          ? [10, 100, 1000, 10000].filter(value => value <= y.domain()[1])
          : y.ticks(6);

        root.append("g")
          .attr("class", "axis y-axis")
          .call(
            d3.axisLeft(y)
              .tickValues(tickValues)
              .tickSize(-innerWidth)
              .tickPadding(9)
              .tickFormat(numberFormat)
          );

        root.append("text")
          .attr("class", "axis-label")
          .attr("x", 0)
          .attr("y", -19)
          .text(state.mode === "annual" ? "MW added" : "Cumulative MW since 2022");

        const estimateX = (xYear("2025") + xYear("2026")) / 2;
        root.append("line")
          .attr("class", "estimate-boundary")
          .attr("x1", estimateX)
          .attr("x2", estimateX)
          .attr("y1", 0)
          .attr("y2", innerHeight);

        const line = d3.line()
          .x(d => xYear(d.year))
          .y(d => y(d.value));

        const seriesGroups = root.append("g")
          .attr("class", "series-layer")
          .selectAll("g.country-series")
          .data(series)
          .join("g")
          .attr("class", "country-series");

        seriesGroups.append("path")
          .attr("class", "country-line observed-segment")
          .attr("d", d => line(d.observations.slice(0, -1)))
          .attr("stroke", d => colorByCountry.get(d.country));

        seriesGroups.append("path")
          .attr("class", "country-line estimate-segment")
          .attr("d", d => line(d.observations.slice(-2)))
          .attr("stroke", d => colorByCountry.get(d.country));

        seriesGroups.selectAll("circle.data-point")
          .data(d => d.observations)
          .join("circle")
          .attr("class", d => `data-point${d.year === "2026" ? " estimate-point" : ""}`)
          .attr("cx", d => xYear(d.year))
          .attr("cy", d => y(d.value))
          .attr("r", d => d.year === "2026" ? 4.2 : 3)
          .attr("fill", d => d.year === "2026" ? null : colorByCountry.get(d.country))
          .attr("stroke", d => colorByCountry.get(d.country));

        seriesGroups.selectAll("circle.point-hit")
          .data(d => d.observations)
          .join("circle")
          .attr("class", "point-hit")
          .attr("cx", d => xYear(d.year))
          .attr("cy", d => y(d.value))
          .attr("r", 10)
          .attr("tabindex", 0)
          .attr("role", "img")
          .attr("aria-label", d => `${d.country}, ${d.year}: ${numberFormat(d.value)} megawatts${state.mode === "cumulative" ? " cumulative since 2022" : " added"}`)
          .on("mouseenter", (event, d) => showTooltip(event, d))
          .on("mousemove", (event) => positionTooltip(event.clientX, event.clientY))
          .on("mouseleave", scheduleTooltipHide)
          .on("focus", (event, d) => showTooltipForElement(event.currentTarget, d))
          .on("blur", scheduleTooltipHide);

        if (showDirectLabels) {
          const labelCandidates = series
            .slice()
            .sort((a, b) => d3.descending(
              a.observations.at(-1).value,
              b.observations.at(-1).value
            ))
            .slice(0, Math.min(4, series.length))
            .map(country => ({
              country: country.country,
              color: colorByCountry.get(country.country),
              y: y(country.observations.at(-1).value)
            }));

          spreadLabels(labelCandidates, 15, 6, innerHeight - 6);
          root.append("g")
            .attr("class", "direct-labels")
            .selectAll("text")
            .data(labelCandidates)
            .join("text")
            .attr("class", "direct-label")
            .attr("x", xYear("2026") + 11)
            .attr("y", d => d.y)
            .attr("dy", "0.35em")
            .attr("fill", d => d.color)
            .text(d => d.country);
        }

        root.append("g")
          .attr("class", "axis year-axis")
          .attr("transform", `translate(0,${innerHeight})`)
          .call(d3.axisBottom(xYear).tickSize(0).tickPadding(15).tickFormat(year => year === "2026" ? "2026 est." : year));

        const lastYearValue = d => d.observations[d.observations.length - 1][state.mode];
        const visibleTotal = d3.sum(visible, lastYearValue);
        const largest = d3.greatest(visible, lastYearValue);
        const scaleLabel = state.scale === "log" ? "Log scale" : "Linear scale · starts at zero";
        const selectionLabel = state.selected.size
          ? `${visibleNames.length} selected ${visibleNames.length === 1 ? "country" : "countries"}`
          : `${visibleNames.length} countries ranked by 2022–26 total`;

        status.textContent = `${state.mode === "annual" ? "Annual additions" : "Cumulative additions"} · ${selectionLabel}`;
        const scrollLabel = window.innerWidth <= 540 ? "Swipe chart → · " : "";
        summary.textContent = `${scrollLabel}${scaleLabel} · 2026 shown: ${numberFormat(visibleTotal)} MW · Largest: ${largest.country}`;
        reset.hidden = state.selected.size === 0;

        document.querySelectorAll(".legend-item").forEach(button => {
          const country = button.dataset.country;
          const selected = state.selected.has(country);
          button.classList.toggle("selected", selected);
          button.classList.toggle("not-shown", !visibleNames.includes(country));
          button.setAttribute("aria-pressed", String(selected));
        });
      }

      function spreadLabels(labels, gap, minY, maxY) {
        labels.sort((a, b) => d3.ascending(a.y, b.y));
        labels.forEach((label, index) => {
          label.y = Math.max(label.y, index === 0 ? minY : labels[index - 1].y + gap);
        });
        for (let index = labels.length - 1; index >= 0; index -= 1) {
          const ceiling = index === labels.length - 1 ? maxY : labels[index + 1].y - gap;
          labels[index].y = Math.min(labels[index].y, ceiling);
        }
      }

      function showTooltip(event, datum) {
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(event.clientX, event.clientY);
      }

      function showTooltipForElement(element, datum) {
        const bounds = element.getBoundingClientRect();
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
      }

      function fillTooltip(datum) {
        document.querySelector("#tooltip-country").textContent = datum.country;
        document.querySelector("#tooltip-year").textContent = datum.year === "2026" ? "2026 · full-year estimate" : datum.year;
        document.querySelector("#tooltip-value").textContent = `${numberFormat(datum.value)} MW`;
        const reasoning = document.querySelector("#tooltip-reasoning");
        reasoning.replaceChildren();
        appendMarkdownLinks(reasoning, datum.reasoning);

        if (state.mode === "cumulative") {
          const note = document.createTextNode(` Cumulative since 2022; the source note above describes the ${datum.year} annual addition of ${numberFormat(datum.annual)} MW.`);
          reasoning.append(note);
        }
      }

      function appendMarkdownLinks(container, text) {
        const pattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g;
        let cursor = 0;
        let match;
        while ((match = pattern.exec(text)) !== null) {
          container.append(document.createTextNode(text.slice(cursor, match.index)));
          const link = document.createElement("a");
          link.href = match[2];
          link.textContent = match[1];
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          container.append(link);
          cursor = pattern.lastIndex;
        }
        container.append(document.createTextNode(text.slice(cursor)));
      }

      function positionTooltip(clientX, clientY) {
        if (tooltip.hidden) return;
        const gap = 14;
        const bounds = tooltip.getBoundingClientRect();
        let left = clientX + gap;
        let top = clientY + gap;
        if (left + bounds.width > window.innerWidth - 8) left = clientX - bounds.width - gap;
        if (top + bounds.height > window.innerHeight - 8) top = clientY - bounds.height - gap;
        tooltip.style.left = `${Math.max(8, left)}px`;
        tooltip.style.top = `${Math.max(8, top)}px`;
      }

      function scheduleTooltipHide() {
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hideTooltip, 180);
      }

      function hideTooltip() {
        clearTimeout(hideTimer);
        tooltip.hidden = true;
      }

      function debounce(fn, wait) {
        let timer;
        return (...args) => {
          clearTimeout(timer);
          timer = setTimeout(() => fn(...args), wait);
        };
      }

      function escapeText(text) {
        const node = document.createElement("div");
        node.textContent = text;
        return node.innerHTML;
      }
    })();
  </script>



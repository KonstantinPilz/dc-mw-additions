+      function spreadLabels(labels, gap, minY, maxY) {
+        labels.sort((a, b) => d3.ascending(a.y, b.y));
+        labels.forEach((label, index) => {
+          label.y = Math.max(label.y, index === 0 ? minY : labels[index - 1].y + gap);
+        });
+        for (let index = labels.length - 1; index >= 0; index -= 1) {
+          const ceiling = index === labels.length - 1 ? maxY : labels[index + 1].y - gap;
+          labels[index].y = Math.min(labels[index].y, ceiling);
+        }
+      }

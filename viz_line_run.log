/bin/bash -lc "python3 - <<'PY'
import base64, hashlib, json, os, socket, struct, time, urllib.request

targets = json.load(urllib.request.urlopen('http://127.0.0.1:9223/json'))
target = next(item for item in targets if item['type'] == 'page' and item['url'].startswith('http://127.0.0.1:8765'))
url = target['webSocketDebuggerUrl']
hostport, path = url.removeprefix('ws://').split('/', 1)
host, port = hostport.split(':')
sock = socket.create_connection((host, int(port)), timeout=5)
key = base64.b64encode(os.urandom(16)).decode()
request = (
    f'GET /{path} HTTP/1.1\\r\\nHost: {hostport}\\r\\nUpgrade: websocket\\r\\n'
    f'Connection: Upgrade\\r\\nSec-WebSocket-Key: {key}\\r\\nSec-WebSocket-Version: 13\\r\\n'
    f'Origin: http://{hostport}\\r\\n\\r\\n'
)
sock.sendall(request.encode())
response = b''
while b'\\r\\n\\r\\n' not in response:
    response += sock.recv(4096)
assert b' 101 ' in response.split(b'\\r\\n', 1)[0], response[:200]

def send_frame(payload):
    data = payload.encode()
    mask = os.urandom(4)
    length = len(data)
    header = bytearray([0x81])
    if length < 126:
        header.append(0x80 | length)
    elif length < 65536:
        header.append(0x80 | 126)
        header.extend(struct.pack('"'!H'"', length))
    else:
        header.append(0x80 | 127)
        header.extend(struct.pack('"'!Q'"', length))
    header.extend(mask)
    header.extend(bytes(byte "'^ mask[i % 4] for i, byte in enumerate(data)))
    sock.sendall(header)

def read_exact(length):
    chunks = bytearray()
    while len(chunks) < length:
        chunk = sock.recv(length - len(chunks))
        if not chunk:
            raise EOFError('"'WebSocket closed')
        chunks.extend(chunk)
    return bytes(chunks)

def read_frame():
    first, second = read_exact(2)
    opcode = first & 0x0f
    length = second & 0x7f
    if length == 126:
        length = struct.unpack('"'!H'"', read_exact(2))[0]
    elif length == 127:
        length = struct.unpack('"'!Q'"', read_exact(8))[0]
    if second & 0x80:
        mask = read_exact(4)
    else:
        mask = None
    payload = read_exact(length)
    if mask:
        payload = bytes(byte "'^ mask[i % 4] for i, byte in enumerate(payload))
    return opcode, payload

next_id = 0
events = []
def command(method, params=None):
    global next_id
    next_id += 1
    request_id = next_id
    send_frame(json.dumps({'"'id': request_id, 'method': method, 'params': params or {}}))
    while True:
        opcode, payload = read_frame()
        if opcode == 9:
            continue
        if opcode "'!= 1:
            continue
        message = json.loads(payload)
        if message.get('"'id') == request_id:
            if 'error' in message:
                raise RuntimeError(message['error'])
            return message.get('result', {})
        events.append(message)

def evaluate(expression):
    result = command('Runtime.evaluate', {'expression': expression, 'returnByValue': True, 'awaitPromise': True})
    value = result['result'].get('value')
    if result['result'].get('subtype') == 'error':
        raise RuntimeError(result)
    return value

command('Runtime.enable')
command('Log.enable')
print('default', evaluate(\"JSON.stringify({lines:document.querySelectorAll('.country-line').length,points:document.querySelectorAll('.point-hit').length,estimates:document.querySelectorAll('.estimate-point').length,status:document.querySelector('#chart-status').textContent,year:[...document.querySelectorAll('.year-axis text')].map(n=>n.textContent)})\"))
print('toggles', evaluate(\"(()=>{for(const value of ['cumulative','linear']){const e=document.querySelector("'`input[value=${value}]`);e.checked=true;e.dispatchEvent(new Event('"'change',{bubbles:true}))}return JSON.stringify({status:document.querySelector('#chart-status').textContent,summary:document.querySelector('#chart-summary').textContent,axis:document.querySelector('.axis-label').textContent})})()\"))
print('all', evaluate(\"(()=>{const e=document.querySelector('#country-count');e.value='all';e.dispatchEvent(new Event('change',{bubbles:true}));return JSON.stringify({lines:document.querySelectorAll('.country-line').length,points:document.querySelectorAll('.point-hit').length,status:document.querySelector('#chart-status').textContent})})()\"))
print('legend', evaluate(\"(()=>{const b=[...document.querySelectorAll('.legend-item')];b[0].click();b[1].click();return JSON.stringify({lines:document.querySelectorAll('.country-line').length,selected:document.querySelectorAll('.legend-item.selected').length,resetHidden:document.querySelector('#reset').hidden})})()\"))
print('tooltip', evaluate(\"(()=>{const p=document.querySelector('.point-hit');p.dispatchEvent(new MouseEvent('mouseenter',{bubbles:true,clientX:200,clientY:200}));return JSON.stringify({hidden:document.querySelector('#tooltip').hidden,country:document.querySelector('#tooltip-country').textContent,links:document.querySelectorAll('#tooltip-reasoning a').length,value:document.querySelector('#tooltip-value').textContent})})()\"))
command('Emulation.setDeviceMetricsOverride', {'width': 375, 'height': 812, 'deviceScaleFactor': 1, 'mobile': True})
evaluate(\"window.dispatchEvent(new Event('resize'))\")
time.sleep(0.3)
print('mobile', evaluate(\"JSON.stringify({viewport:innerWidth,svg:Number(document.querySelector('#chart').getAttribute('width')),labels:document.querySelectorAll('.direct-label').length})\"))
command('Emulation.setEmulatedMedia', {'features': [{'name':'prefers-color-scheme','value':'dark'}]})
print('dark', evaluate(\"JSON.stringify({bg:getComputedStyle(document.body).backgroundColor,surface:getComputedStyle(document.querySelector('.chart-card')).backgroundColor})\"))
errors = []
for event in events:
    method = event.get('method')
    params = event.get('params', {})
    if method == 'Runtime.exceptionThrown':
        errors.append(params.get('exceptionDetails', {}).get('text', 'exception'))
    elif method == 'Log.entryAdded' and params.get('entry', {}).get('level') == 'error':
        errors.append(params['entry'].get('text', 'log error'))
    elif method == 'Runtime.consoleAPICalled' and params.get('type') == 'error':
        errors.append('console.error')
print('page_errors', json.dumps(errors))
sock.close()

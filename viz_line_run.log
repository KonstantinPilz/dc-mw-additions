        const scaleLabel = state.scale === "log" ? "Log scale · bars start at 5 MW" : "Linear scale · starts at zero";
        const selectionLabel = state.selected.size
          ? `${visibleNames.length} selected ${visibleNames.length === 1 ? "country" : "countries"}`
          : `${visibleNames.length} countries ranked by 2022–26 total`;

        status.textContent = `${state.mode === "annual" ? "Annual additions" : "Cumulative additions"} · ${selectionLabel}`;
        const scrollLabel = window.innerWidth <= 540 ? "Swipe chart → · " : "";
        summary.textContent = `${scrollLabel}${scaleLabel} · 2026 shown: ${numberFormat(visibleTotal)} MW · Largest: ${largest.country}`;
        reset.hidden = state.selected.size === 0;

        document.querySelectorAll(".legend-item").forEach(button => {
          const country = button.dataset.country;
          const selected = state.selected.has(country);
          button.classList.toggle("selected", selected);
          button.classList.toggle("not-shown", !visibleNames.includes(country));
          button.setAttribute("aria-pressed", String(selected));
        });
      }

      function showTooltip(event, datum) {
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(event.clientX, event.clientY);
      }

      function showTooltipForElement(element, datum) {
        const bounds = element.getBoundingClientRect();
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
      }

      function fillTooltip(datum) {
        document.querySelector("#tooltip-country").textContent = datum.country;
        document.querySelector("#tooltip-year").textContent = datum.year === "2026" ? "2026 · full-year estimate" : datum.year;
        document.querySelector("#tooltip-value").textContent = `${numberFormat(datum.value)} MW`;
        const reasoning = document.querySelector("#tooltip-reasoning");
        reasoning.replaceChildren();
        appendMarkdownLinks(reasoning, datum.reasoning);

        if (state.mode === "cumulative") {
          const note = document.createTextNode(` Cumulative since 2022; the source note above describes the ${datum.year} annual addition of ${numberFormat(datum.annual)} MW.`);
          reasoning.append(note);
        }
      }

      function appendMarkdownLinks(container, text) {
        const pattern = /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g;
        let cursor = 0;
        let match;
        while ((match = pattern.exec(text)) !== null) {
          container.append(document.createTextNode(text.slice(cursor, match.index)));
          const link = document.createElement("a");
          link.href = match[2];
          link.textContent = match[1];
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          container.append(link);
          cursor = pattern.lastIndex;
        }
        container.append(document.createTextNode(text.slice(cursor)));
      }

      function positionTooltip(clientX, clientY) {
        if (tooltip.hidden) return;
        const gap = 14;
        const bounds = tooltip.getBoundingClientRect();
        let left = clientX + gap;
        let top = clientY + gap;
        if (left + bounds.width > window.innerWidth - 8) left = clientX - bounds.width - gap;
        if (top + bounds.height > window.innerHeight - 8) top = clientY - bounds.height - gap;
        tooltip.style.left = `${Math.max(8, left)}px`;
        tooltip.style.top = `${Math.max(8, top)}px`;
      }

      function scheduleTooltipHide() {
        clearTimeout(hideTimer);
        hideTimer = setTimeout(hideTooltip, 180);
      }

      function hideTooltip() {
        clearTimeout(hideTimer);
        tooltip.hidden = true;
      }

      function debounce(fn, wait) {
        let timer;
        return (...args) => {
          clearTimeout(timer);
          timer = setTimeout(() => fn(...args), wait);
        };
      }

      function escapeText(text) {
        const node = document.createElement("div");
        node.textContent = text;
        return node.innerHTML;
      }
    })();
  </script>

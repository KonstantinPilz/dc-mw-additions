      };

      const svg = d3.select("#chart");
      const chartScroll = document.querySelector("#chart-scroll");
      const status = document.querySelector("#chart-status");
      const summary = document.querySelector("#chart-summary");
      const legend = document.querySelector("#legend");
      const reset = document.querySelector("#reset");
      const tooltip = document.querySelector("#tooltip");
      const numberFormat = d3.format(",.0f");
      let countries = [];
      let rankedCountries = [];
      let colorByCountry = new Map();
      let hideTimer;

      // Top-eight plus a log scale is the default because a 24,000 MW U.S. value
      // and a 44 MW Taiwan value cannot both read clearly on one linear axis.
      // The ranking selector exposes every country; legend choices override it.
      fetch("data.json")
        .then(response => {
          if (!response.ok) throw new Error(`Data request failed (${response.status})`);
          return response.json();
        })
        .then(data => {
          countries = Object.entries(data.countries).map(([country, values]) => {
            let running = 0;
            const observations = years.map(year => {
              const observation = values[year];
              running += observation.mw;
              return {
                country,
                year,
                annual: observation.mw,
                cumulative: running,
                reasoning: observation.reasoning
              };
            });
            return { country, observations, total: running };
          });

          rankedCountries = countries
            .slice()
            .sort((a, b) => d3.descending(a.total, b.total))
            .map(d => d.country);

          let paletteIndex = 0;
          rankedCountries.forEach(country => {
            colorByCountry.set(country, specialColors[country] || colors[paletteIndex++ % colors.length]);
          });

          buildLegend();
          render();
        })
        .catch(error => {
          status.textContent = "Unable to load the dataset";
          summary.textContent = "";
          chartScroll.innerHTML = `<p class="error">${escapeText(error.message)}. Serve this directory over HTTP so the page can fetch data.json.</p>`;
        });

      document.querySelector("#controls").addEventListener("change", event => {
        if (event.target.name === "mode") state.mode = event.target.value;
        if (event.target.name === "scale") state.scale = event.target.value;
        if (event.target.id === "country-count") {
          state.count = event.target.value;
          state.selected.clear();
        }
        render();
      });

      reset.addEventListener("click", () => {
        state.selected.clear();
        hideTooltip();
        render();
      });

      tooltip.addEventListener("mouseenter", () => clearTimeout(hideTimer));
      tooltip.addEventListener("mouseleave", scheduleTooltipHide);
      window.addEventListener("resize", debounce(render, 120));
      window.addEventListener("scroll", hideTooltip, { passive: true });

      function visibleCountryNames() {
        if (state.selected.size) {
          return rankedCountries.filter(country => state.selected.has(country));
        }
        const count = state.count === "all" ? rankedCountries.length : Number(state.count);
        return rankedCountries.slice(0, count);
      }

      function buildLegend() {
        legend.replaceChildren();
        rankedCountries.forEach(country => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "legend-item";
          button.dataset.country = country;
          button.setAttribute("aria-pressed", "false");
          button.title = `Compare ${country}`;

          const swatch = document.createElement("span");
          swatch.className = "swatch";
          swatch.style.backgroundColor = colorByCountry.get(country);
          swatch.setAttribute("aria-hidden", "true");

          const name = document.createElement("span");
          name.className = "country-name";
          name.textContent = country;

          button.append(swatch, name);
          button.addEventListener("click", () => {
            if (!state.selected.size) {
              state.selected.add(country);
            } else if (state.selected.has(country)) {
              state.selected.delete(country);
            } else {
              state.selected.add(country);
            }
            hideTooltip();
            render();
          });
          legend.append(button);
        });
      }

      function render() {
        if (!countries.length) return;

        hideTooltip();
        const visibleNames = visibleCountryNames();
        const visible = countries.filter(d => visibleNames.includes(d.country));
        const values = visible.flatMap(country => country.observations.map(observation => ({
          ...observation,
          value: observation[state.mode]
        })));

        // All-country mode needs slightly more horizontal room so each grouped bar
        // remains a usable hover target on small screens.
        const availableWidth = Math.max(chartScroll.clientWidth, 320);
        const minWidth = Math.max(680, visibleNames.length * 31 + 330);
        const width = Math.max(availableWidth, minWidth);
        const height = 480;
        const margin = { top: 38, right: 24, bottom: 52, left: width < 760 ? 58 : 70 };
        const innerWidth = width - margin.left - margin.right;
        const innerHeight = height - margin.top - margin.bottom;
        const maxValue = d3.max(values, d => d.value);

        svg.attr("width", width).attr("height", height).attr("viewBox", `0 0 ${width} ${height}`);
        svg.selectAll("g.chart-layer").remove();

        const root = svg.append("g")
          .attr("class", "chart-layer")
          .attr("transform", `translate(${margin.left},${margin.top})`);

        const xYear = d3.scaleBand()
          .domain(years)
          .range([0, innerWidth])
          .paddingInner(0.22)
          .paddingOuter(0.05);

        const xCountry = d3.scaleBand()
          .domain(visibleNames)
          .range([0, xYear.bandwidth()])
          .padding(0.08);

        const logFloor = 5;
        const y = state.scale === "log"
          ? d3.scaleLog().domain([logFloor, Math.max(10, maxValue * 1.14)]).range([innerHeight, 0]).nice()
          : d3.scaleLinear().domain([0, maxValue * 1.08]).range([innerHeight, 0]).nice();

        const tickValues = state.scale === "log"
          ? [10, 100, 1000, 10000].filter(value => value <= y.domain()[1])
          : y.ticks(6);

        root.append("g")
          .attr("class", "axis y-axis")
          .call(
            d3.axisLeft(y)
              .tickValues(tickValues)
              .tickSize(-innerWidth)
              .tickPadding(9)
              .tickFormat(numberFormat)
          );

        root.append("text")
          .attr("class", "axis-label")
          .attr("x", 0)
          .attr("y", -19)
          .text(state.mode === "annual" ? "MW added" : "Cumulative MW since 2022");

        const estimateX = xYear("2026") - xYear.step() * 0.11;
        root.append("line")
          .attr("class", "estimate-marker")
          .attr("x1", estimateX)
          .attr("x2", estimateX)
          .attr("y1", 0)
          .attr("y2", innerHeight);

        const yearGroups = root.selectAll("g.year-group")
          .data(years)
          .join("g")
          .attr("class", "year-group")
          .attr("transform", year => `translate(${xYear(year)},0)`);

        yearGroups.selectAll("rect")
          .data(year => values.filter(d => d.year === year))
          .join("rect")
          .attr("class", "bar")
          .attr("x", d => xCountry(d.country))
          .attr("y", d => y(d.value))
          .attr("width", Math.max(1, xCountry.bandwidth()))
          .attr("height", d => Math.max(1, y(state.scale === "log" ? logFloor : 0) - y(d.value)))
          .attr("rx", 1.5)
          .attr("fill", d => colorByCountry.get(d.country))
          .attr("tabindex", 0)
          .attr("role", "img")
          .attr("aria-label", d => `${d.country}, ${d.year}: ${numberFormat(d.value)} megawatts${state.mode === "cumulative" ? " cumulative since 2022" : " added"}`)
          .on("mouseenter", (event, d) => showTooltip(event, d))
          .on("mousemove", (event) => positionTooltip(event.clientX, event.clientY))
          .on("mouseleave", scheduleTooltipHide)
          .on("focus", (event, d) => showTooltipForElement(event.currentTarget, d))
          .on("blur", scheduleTooltipHide);



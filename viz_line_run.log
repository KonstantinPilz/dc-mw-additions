<body>
  <main class="page">
    <header class="masthead">
      <div>
        <p class="eyebrow">IT power · median estimates</p>
        <h1>Data-center capacity additions by country, <span class="nowrap">2022–2026</span></h1>
        <p class="dek">Compare annual additions or each country’s cumulative build-out. The default log scale keeps smaller markets legible beside the United States and China.</p>
      </div>
      <dl class="key" aria-label="Chart definitions">
        <div>
          <dt>Measure</dt>
          <dd>Critical IT capacity</dd>
        </div>
        <div>
          <dt>2026</dt>
          <dd>Full-year estimate</dd>
        </div>
      </dl>
    </header>

    <section class="chart-card" aria-label="Interactive capacity additions chart">
      <form class="controls" id="controls">
        <fieldset>
          <legend>Measure</legend>
          <div class="segmented">
            <label><input type="radio" name="mode" value="annual" checked><span>Annual</span></label>
            <label><input type="radio" name="mode" value="cumulative"><span>Since 2022</span></label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Scale</legend>
          <div class="segmented">
            <label><input type="radio" name="scale" value="log" checked><span>Log</span></label>
            <label><input type="radio" name="scale" value="linear"><span>Linear</span></label>
          </div>
        </fieldset>

        <label>
          <span class="select-label">Countries</span>
          <select id="country-count" aria-label="Number of countries shown">
            <option value="8">Top 8</option>
            <option value="12">Top 12</option>
            <option value="all">All 22</option>
          </select>
        </label>

        <button class="reset" id="reset" type="button" hidden>Return to ranking</button>
      </form>

      <div class="chart-meta" aria-live="polite">
        <strong id="chart-status">Loading data…</strong>
        <span id="chart-summary"></span>
      </div>

      <div class="chart-scroll" id="chart-scroll">
        <svg id="chart" role="img" aria-labelledby="svg-title svg-desc">
          <title id="svg-title">Data-center capacity additions by country from 2022 to 2026</title>
          <desc id="svg-desc">A grouped bar chart. Use the controls to change the measure, scale, and countries shown.</desc>
        </svg>
      </div>

      <div class="legend-wrap">
        <div class="legend-head">
          <h2>Countries</h2>
          <p>Click one to isolate it, then add others to compare.</p>
        </div>
        <div id="legend" aria-label="Country comparison controls"></div>
      </div>
    </section>

    <footer>
      <p>Data: Konstantin's Claude research team, 2026-08-12. Medians; 2026 is a full-year estimate. Definitions: IT (critical) MW, colo + hyperscale + AI campuses.</p>
      <p class="caveat">China 2024–25 partly reflects a statistical series change; US 2026 follows SemiAnalysis's construction-backed forecast.</p>
    </footer>
  </main>

  <aside class="tooltip" id="tooltip" hidden aria-live="polite">
    <div class="tooltip-top">
      <div>
        <h3 id="tooltip-country"></h3>
        <p class="tooltip-year" id="tooltip-year"></p>
      </div>
      <div class="tooltip-value" id="tooltip-value"></div>
    </div>
    <p class="tooltip-reasoning" id="tooltip-reasoning"></p>
  </aside>

  <script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>

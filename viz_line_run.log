      function buildLegend() {
        legend.replaceChildren();
        rankedCountries.forEach(country => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "legend-item";
          button.dataset.country = country;
          button.setAttribute("aria-pressed", "false");
          button.title = `Compare ${country}`;

          const swatch = document.createElement("span");
          swatch.className = "swatch";
          swatch.style.backgroundColor = colorByCountry.get(country);
          swatch.setAttribute("aria-hidden", "true");

          const name = document.createElement("span");
          name.className = "country-name";
          name.textContent = country;

          button.append(swatch, name);
          button.addEventListener("click", () => {
            if (!state.selected.size) {
              state.selected.add(country);
            } else if (state.selected.has(country)) {
              state.selected.delete(country);
            } else {
              state.selected.add(country);
            }
            hideTooltip();
            render();
          });
          legend.append(button);
        });
      }

      function render() {
        if (!countries.length) return;

        hideTooltip();
        const visibleNames = visibleCountryNames();
        const countryByName = new Map(countries.map(country => [country.country, country]));
        const visible = visibleNames.map(country => countryByName.get(country));
        const series = visible.map(country => ({
          ...country,
          observations: country.observations.map(observation => ({
            ...observation,
            value: observation[state.mode]
          }))
        }));
        const values = series.flatMap(country => country.observations);

        const availableWidth = Math.max(chartScroll.clientWidth, 320);
        const width = availableWidth;
        const height = width < 560 ? 450 : 500;
        const showDirectLabels = width >= 760;
        const margin = {
          top: 38,
          right: showDirectLabels ? 132 : 22,
          bottom: 58,
          left: width < 560 ? 54 : 70
        };
        const innerWidth = width - margin.left - margin.right;
        const innerHeight = height - margin.top - margin.bottom;
        const maxValue = d3.max(values, d => d.value);

        svg.attr("width", width).attr("height", height).attr("viewBox", `0 0 ${width} ${height}`);
        svg.selectAll("g.chart-layer").remove();

        const root = svg.append("g")
          .attr("class", "chart-layer")
          .attr("transform", `translate(${margin.left},${margin.top})`);

        const xYear = d3.scalePoint()
          .domain(years)
          .range([0, innerWidth]);

        const logFloor = 5;
        const y = state.scale === "log"
          ? d3.scaleLog().domain([logFloor, Math.max(10, maxValue * 1.14)]).range([innerHeight, 0]).nice()
          : d3.scaleLinear().domain([0, maxValue * 1.08]).range([innerHeight, 0]).nice();

        const tickValues = state.scale === "log"
          ? [10, 100, 1000, 10000].filter(value => value <= y.domain()[1])
          : y.ticks(6);

        root.append("g")
          .attr("class", "axis y-axis")
          .call(
            d3.axisLeft(y)
              .tickValues(tickValues)
              .tickSize(-innerWidth)
              .tickPadding(9)
              .tickFormat(numberFormat)
          );

        root.append("text")
          .attr("class", "axis-label")
          .attr("x", 0)
          .attr("y", -19)
          .text(state.mode === "annual" ? "MW added" : "Cumulative MW since 2022");

        const estimateX = (xYear("2025") + xYear("2026")) / 2;
        root.append("line")
          .attr("class", "estimate-boundary")
          .attr("x1", estimateX)
          .attr("x2", estimateX)
          .attr("y1", 0)
          .attr("y2", innerHeight);

        const line = d3.line()
          .x(d => xYear(d.year))
          .y(d => y(d.value));

        const seriesGroups = root.append("g")
          .attr("class", "series-layer")
          .selectAll("g.country-series")
          .data(series)
          .join("g")
          .attr("class", "country-series");

        seriesGroups.append("path")
          .attr("class", "country-line observed-segment")
          .attr("d", d => line(d.observations.slice(0, -1)))
          .attr("stroke", d => colorByCountry.get(d.country));

        seriesGroups.append("path")
          .attr("class", "country-line estimate-segment")
          .attr("d", d => line(d.observations.slice(-2)))
          .attr("stroke", d => colorByCountry.get(d.country));

        seriesGroups.selectAll("circle.data-point")
          .data(d => d.observations)
          .join("circle")
          .attr("class", d => `data-point${d.year === "2026" ? " estimate-point" : ""}`)
          .attr("cx", d => xYear(d.year))
          .attr("cy", d => y(d.value))
          .attr("r", d => d.year === "2026" ? 4.2 : 3)
          .attr("fill", d => d.year === "2026" ? null : colorByCountry.get(d.country))
          .attr("stroke", d => colorByCountry.get(d.country));

        seriesGroups.selectAll("circle.point-hit")
          .data(d => d.observations)
          .join("circle")
          .attr("class", "point-hit")
          .attr("cx", d => xYear(d.year))
          .attr("cy", d => y(d.value))
          .attr("r", 10)
          .attr("tabindex", 0)
          .attr("role", "img")
          .attr("aria-label", d => `${d.country}, ${d.year}: ${numberFormat(d.value)} megawatts${state.mode === "cumulative" ? " cumulative since 2022" : " added"}`)
          .on("mouseenter", (event, d) => showTooltip(event, d))
          .on("mousemove", (event) => positionTooltip(event.clientX, event.clientY))
          .on("mouseleave", scheduleTooltipHide)
          .on("focus", (event, d) => showTooltipForElement(event.currentTarget, d))
          .on("blur", scheduleTooltipHide);

        if (showDirectLabels) {
          const labelCandidates = series
            .slice()
            .sort((a, b) => d3.descending(
              a.observations.at(-1).value,
              b.observations.at(-1).value
            ))
            .slice(0, Math.min(4, series.length))
            .map(country => ({
              country: country.country,
              color: colorByCountry.get(country.country),
              y: y(country.observations.at(-1).value)
            }));

          spreadLabels(labelCandidates, 15, 6, innerHeight - 6);
          root.append("g")
            .attr("class", "direct-labels")
            .selectAll("text")
            .data(labelCandidates)
            .join("text")
            .attr("class", "direct-label")
            .attr("x", xYear("2026") + 11)
            .attr("y", d => d.y)
            .attr("dy", "0.35em")
            .attr("fill", d => d.color)
            .text(d => d.country);
        }

        root.append("g")
          .attr("class", "axis year-axis")
          .attr("transform", `translate(0,${innerHeight})`)
          .call(d3.axisBottom(xYear).tickSize(0).tickPadding(15).tickFormat(year => year === "2026" ? "2026 est." : year));

        const lastYearValue = d => d.observations[d.observations.length - 1][state.mode];
        const visibleTotal = d3.sum(visible, lastYearValue);
        const largest = d3.greatest(visible, lastYearValue);
        const scaleLabel = state.scale === "log" ? "Log scale" : "Linear scale · starts at zero";
        const selectionLabel = state.selected.size
          ? `${visibleNames.length} selected ${visibleNames.length === 1 ? "country" : "countries"}`
          : `${visibleNames.length} countries ranked by 2022–26 total`;

        status.textContent = `${state.mode === "annual" ? "Annual additions" : "Cumulative additions"} · ${selectionLabel}`;
        const scrollLabel = window.innerWidth <= 540 ? "Swipe chart → · " : "";
        summary.textContent = `${scrollLabel}${scaleLabel} · 2026 shown: ${numberFormat(visibleTotal)} MW · Largest: ${largest.country}`;
        reset.hidden = state.selected.size === 0;

        document.querySelectorAll(".legend-item").forEach(button => {
          const country = button.dataset.country;
          const selected = state.selected.has(country);
          button.classList.toggle("selected", selected);
          button.classList.toggle("not-shown", !visibleNames.includes(country));
          button.setAttribute("aria-pressed", String(selected));
        });
      }

      function spreadLabels(labels, gap, minY, maxY) {
        labels.sort((a, b) => d3.ascending(a.y, b.y));
        labels.forEach((label, index) => {
          label.y = Math.max(label.y, index === 0 ? minY : labels[index - 1].y + gap);
        });
        for (let index = labels.length - 1; index >= 0; index -= 1) {
          const ceiling = index === labels.length - 1 ? maxY : labels[index + 1].y - gap;
          labels[index].y = Math.min(labels[index].y, ceiling);
        }
      }

      function showTooltip(event, datum) {
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(event.clientX, event.clientY);
      }

      function showTooltipForElement(element, datum) {
        const bounds = element.getBoundingClientRect();
        fillTooltip(datum);
        tooltip.hidden = false;
        positionTooltip(bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
      }

      function fillTooltip(datum) {
        document.querySelector("#tooltip-country").textContent = datum.country;
        document.querySelector("#tooltip-year").textContent = datum.year === "2026" ? "2026 · full-year estimate" : datum.year;
        document.querySelector("#tooltip-value").textContent = `${numberFormat(datum.value)} MW`;

